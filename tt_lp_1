import pygame as pg
import sys

pg.init()

try:
    bg = pg.image.load('background.png').convert()
except:
    bg = pg.Surface((800, 600))
    bg.fill((135, 206, 235)) 

W, H = bg.get_size()
sc = pg.display.set_mode((W, H))
pg.display.set_caption("Sun Mover")

try:
    sun = pg.image.load('sun.png').convert_alpha()
except:
    sun = pg.Surface((50, 50), pg.SRCALPHA)
    pg.draw.circle(sun, (255, 255, 0), (25, 25), 25)

sun_rect = sun.get_rect(center=(W//2, H//2))
clock = pg.time.Clock()

while True:
    for event in pg.event.get():
        if event.type == pg.QUIT:
            pg.quit()
            sys.exit()
        
        if event.type == pg.KEYDOWN and event.key == pg.K_s:
            pg.image.save(sc, 'screenshot.png')

    keys = pg.key.get_pressed()
    if keys[pg.K_LEFT] and sun_rect.left > 0:
        sun_rect.x -= 5
    if keys[pg.K_RIGHT] and sun_rect.right < W:
        sun_rect.x += 5

    sc.blit(bg, (0, 0))
    sc.blit(sun, sun_rect)
    
    pg.display.update()
    clock.tick(60)
