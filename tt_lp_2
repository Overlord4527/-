import pygame
import sys

pygame.init()
W, H = 800, 600
sc = pygame.display.set_mode((W, H))
clock = pygame.time.Clock()

origin_car = pygame.image.load('car.png').convert_alpha()
car_surf = origin_car
car_rect = car_surf.get_rect(center=(W/2, H/2))

speed = 5

while True:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            sys.exit()

    keys = pygame.key.get_pressed()

    if keys[pygame.K_LEFT]:
        car_rect.x -= speed
        car_surf = pygame.transform.rotate(origin_car, 90)
    elif keys[pygame.K_RIGHT]:
        car_rect.x += speed
        car_surf = pygame.transform.rotate(origin_car, -90)
    elif keys[pygame.K_UP]:
        car_rect.y -= speed
        car_surf = origin_car # Вверх — это исходное положение
    elif keys[pygame.K_DOWN]:
        car_rect.y += speed
        car_surf = pygame.transform.rotate(origin_car, 180)

    sc.fill((100, 170, 220))
    sc.blit(car_surf, car_rect)
    pygame.display.update()
    clock.tick(60)
